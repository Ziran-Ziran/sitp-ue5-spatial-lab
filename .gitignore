# Source-only allowlist; local data and experiments are never force-added.
/*
!/.gitattributes
!/.editorconfig
!/README.md
!/CONTRIBUTING.md
!/SECURITY.md
!/NOTICE.md
!/AGENTS.md
!/repository-policy.json
!/.gitignore
!/.github/
!/scripts/
!/tests/
!/requirements/
!/experiments/
!/engineering/
!/docs/
!/ue5/
/docs/*
!/docs/README.md
!/docs/architecture.md
!/docs/development.md
!/docs/roadmap.md
!/docs/repository-policy.md
!/docs/migration.md
!/docs/shared-engineering.md
!/docs/data-contract.md
!/docs/research-plan.md
/ue5/*
!/ue5/tools/
!/ue5/GSVSLAM/
/ue5/GSVSLAM/*
!/ue5/GSVSLAM/GSVSLAM.uproject
!/ue5/GSVSLAM/Source/
!/ue5/GSVSLAM/Config/
/ue5/GSVSLAM/Config/*
!/ue5/GSVSLAM/Config/DefaultEngine.ini
!/ue5/GSVSLAM/Config/DefaultGame.ini
!/ue5/GSVSLAM/Config/DefaultInput.ini

